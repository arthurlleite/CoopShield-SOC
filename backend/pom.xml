<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>

  <parent>
    <groupId>org.springframework.boot</groupId>
    <artifactId>spring-boot-starter-parent</artifactId>
    <version>3.5.16</version>
    <relativePath/>
  </parent>

  <groupId>com.coopshield.soc</groupId>
  <artifactId>coopshield-soc-backend</artifactId>
  <version>0.1.0-SNAPSHOT</version>
  <packaging>pom</packaging>

  <name>CoopShield SOC Backend</name>
  <description>
    Monolito modular orientado a eventos do CoopShield SOC. Projeto independente,
    educacional e de portfolio; todos os dados processados sao sinteticos.
  </description>

  <properties>
    <java.version>21</java.version>
    <maven.compiler.release>21</maven.compiler.release>
    <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
    <project.reporting.outputEncoding>UTF-8</project.reporting.outputEncoding>
  </properties>

  <modules>
    <module>sharedkernel</module>
    <module>identity</module>
    <module>accesscontrol</module>
    <module>eventingestion</module>
    <module>eventnormalization</module>
    <module>dataprotection</module>
    <module>detection</module>
    <module>risk</module>
    <module>alert</module>
    <module>incident</module>
    <module>playbook</module>
    <module>audit</module>
    <module>observability</module>
    <module>simulation</module>
    <module>app</module>
  </modules>

  <dependencyManagement>
    <dependencies>
      <dependency>
        <groupId>com.coopshield.soc</groupId>
        <artifactId>sharedkernel</artifactId>
        <version>${project.version}</version>
      </dependency>
      <dependency>
        <groupId>com.coopshield.soc</groupId>
        <artifactId>identity</artifactId>
        <version>${project.version}</version>
      </dependency>
      <dependency>
        <groupId>com.coopshield.soc</groupId>
        <artifactId>accesscontrol</artifactId>
        <version>${project.version}</version>
      </dependency>
      <dependency>
        <groupId>com.coopshield.soc</groupId>
        <artifactId>eventingestion</artifactId>
        <version>${project.version}</version>
      </dependency>
      <dependency>
        <groupId>com.coopshield.soc</groupId>
        <artifactId>eventnormalization</artifactId>
        <version>${project.version}</version>
      </dependency>
      <dependency>
        <groupId>com.coopshield.soc</groupId>
        <artifactId>dataprotection</artifactId>
        <version>${project.version}</version>
      </dependency>
      <dependency>
        <groupId>com.coopshield.soc</groupId>
        <artifactId>detection</artifactId>
        <version>${project.version}</version>
      </dependency>
      <dependency>
        <groupId>com.coopshield.soc</groupId>
        <artifactId>risk</artifactId>
        <version>${project.version}</version>
      </dependency>
      <dependency>
        <groupId>com.coopshield.soc</groupId>
        <artifactId>alert</artifactId>
        <version>${project.version}</version>
      </dependency>
      <dependency>
        <groupId>com.coopshield.soc</groupId>
        <artifactId>incident</artifactId>
        <version>${project.version}</version>
      </dependency>
      <dependency>
        <groupId>com.coopshield.soc</groupId>
        <artifactId>playbook</artifactId>
        <version>${project.version}</version>
      </dependency>
      <dependency>
        <groupId>com.coopshield.soc</groupId>
        <artifactId>audit</artifactId>
        <version>${project.version}</version>
      </dependency>
      <dependency>
        <groupId>com.coopshield.soc</groupId>
        <artifactId>observability</artifactId>
        <version>${project.version}</version>
      </dependency>
      <dependency>
        <groupId>com.coopshield.soc</groupId>
        <artifactId>simulation</artifactId>
        <version>${project.version}</version>
      </dependency>
    </dependencies>
  </dependencyManagement>

  <dependencies>
    <dependency>
      <groupId>org.junit.jupiter</groupId>
      <artifactId>junit-jupiter</artifactId>
      <scope>test</scope>
    </dependency>
    <dependency>
      <groupId>org.assertj</groupId>
      <artifactId>assertj-core</artifactId>
      <scope>test</scope>
    </dependency>
  </dependencies>

  <build>
    <pluginManagement>
      <plugins>
        <plugin>
          <groupId>org.apache.maven.plugins</groupId>
          <artifactId>maven-surefire-plugin</artifactId>
        </plugin>
      </plugins>
    </pluginManagement>
  </build>
</project>
