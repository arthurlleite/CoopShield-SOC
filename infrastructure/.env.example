# CoopShield SOC - variaveis de ambiente para execucao local via Docker Compose.
# Copie este arquivo para .env e ajuste os valores se necessario.
# Nenhum destes valores representa um segredo real; sao credenciais
# sinteticas de uso exclusivamente local, conforme docs/adr/ADR-010-dados-sinteticos.md.

MONGO_INITDB_ROOT_USERNAME=coopshield-local
MONGO_INITDB_ROOT_PASSWORD=change-me-local-only

SPRING_PROFILES_ACTIVE=docker

BACKEND_HTTP_PORT=8080
FRONTEND_HTTP_PORT=8081
